{
  "name": "chime",
  "version": "0.3.0",
  "description": "查询 CHIME/FRB 重复暴目录，并可靠通知新增重复暴和新脉冲",
  "author": "XiaoQing Bot",
  "entry": "main.py",
  "commands": [
    {
      "name": "chime",
      "triggers": [
        "chime",
        "frb"
      ],
      "help": "查询CHIME/FRB重复暴天体源与脉冲数据，论文检索用paper search。无参数预览上次成功通知后的更新；list 列最近更新的5个源；完整 FRB 名称查单源资料。手动查询保持通知游标。",
      "admin_only": false,
      "usage": "/chime [list|FRB名称]",
      "examples": ["/chime", "/chime FRB20180916B"],
      "invalid_examples": ["/chime unknown source"],
      "subcommands": [
        {
          "name": "list",
          "aliases": ["列表"],
          "help": "列出最近更新的 5 个重复暴",
          "usage": "/chime list",
          "match": "exact",
          "examples": ["/chime list"],
          "invalid_examples": ["/chime list extra"]
        },
        {
          "name": "help",
          "aliases": ["帮助"],
          "help": "显示 CHIME/FRB 命令说明",
          "usage": "/chime help",
          "match": "exact",
          "examples": ["/chime help"],
          "invalid_examples": ["/chime help extra"]
        }
      ]
    }
  ],
  "schedule": [
    {
      "id": "chime_check",
      "handler": "scheduled_check",
      "delivery": "targeted",
      "cron": {
        "hour": "9,21",
        "minute": 0
      },
      "description": "每天 09:00 和 21:00 检查 CHIME/FRB 重复暴目录"
    }
  ],
  "dependencies": []
}
