{
  "name": "chat",
  "version": "0.2.0",
  "description": "基于 Coze API v3 的单轮 AI 对话插件，支持每日额度和失败回滚",
  "author": "XiaoQing Bot",
  "entry": "main.py",
  "services": [
    {
      "name": "chat.reply",
      "callback": "reply",
      "callers": ["smalltalk"]
    }
  ],
  "commands": [
    {
      "name": "chat",
      "triggers": ["chat", "gpt", "ai"],
      "help": "与 AI 进行单轮对话 | /chat <问题>",
      "admin_only": true,
      "usage": "/chat <问题>",
      "examples": ["/chat 用三句话解释快速射电暴"],
      "invalid_examples": ["/chat"],
      "subcommands": [
        {
          "name": "help",
          "aliases": ["帮助"],
          "help": "显示单轮 AI 对话说明",
          "usage": "/chat help",
          "match": "exact",
          "examples": ["/chat help"],
          "invalid_examples": ["/chat help extra"]
        }
      ]
    }
  ],
  "schedule": [],
  "dependencies": []
}
