{
    "name": "color",
    "version": "0.5.0",
    "description": "支持直接查询、拼音搜索、分页浏览和感知近似匹配的颜色工具（内置 526 种中国传统色）",
    "author": "XiaoQing Bot",
    "entry": "main.py",
    "commands": [
        {
            "name": "color",
            "triggers": [
                "color",
                "颜色",
                "色彩"
            ],
            "help": "颜色查询与浏览 | 直接输入名称/拼音/HEX/RGB，或使用 list/search/random",
            "admin_only": false,
            "usage": "/color <名称|拼音|HEX|RGB> [-p] | /color <list|search|random|star|stars|add|delete> [参数]",
            "examples": ["/color 乳白", "/color rubai", "/color list", "/color search 红", "/color #66CCFF --picture"],
            "invalid_examples": ["/color -p", "/color list 0", "/color search", "/color --unknown"],
            "subcommands": [
                {
                    "name": "name",
                    "aliases": ["名称", "-n", "--name"],
                    "help": "按完整名称查询；直接输入名称时也会自动识别",
                    "usage": "/color [name|-n|--name] <名称> [-p|--picture]",
                    "examples": ["/color name 乳白", "/color -n 乳白 -p"],
                    "invalid_examples": ["/color -n"]
                },
                {
                    "name": "rgb",
                    "aliases": ["-r", "--rgb"],
                    "help": "按 RGB 查询精确或最接近的传统色",
                    "usage": "/color [rgb|-r|--rgb] <R,G,B|R G B> [-p|--picture]",
                    "examples": ["/color rgb 102 204 255", "/color -r 102,204,255 -p"],
                    "invalid_examples": ["/color rgb", "/color rgb 999 0 0"]
                },
                {
                    "name": "hex",
                    "aliases": ["-x", "--hex"],
                    "help": "按十六进制颜色查询最接近的传统色",
                    "usage": "/color [hex|-x|--hex] <HEX> [-p|--picture]",
                    "examples": ["/color hex 66CCFF", "/color -x 66CCFF -p"],
                    "invalid_examples": ["/color hex", "/color hex ZZZZZZ"]
                },
                {
                    "name": "cmyk",
                    "aliases": ["-c", "--cmyk"],
                    "help": "按 CMYK 四元组查询最接近的传统色",
                    "usage": "/color [cmyk|-c|--cmyk] <C,M,Y,K|C M Y K> [-p|--picture]",
                    "examples": ["/color cmyk 50 20 0 0", "/color -c 50,20,0,0"],
                    "invalid_examples": ["/color cmyk", "/color cmyk 10 20 30"]
                },
                {
                    "name": "list",
                    "aliases": ["ls", "列表", "色表", "-l", "--list"],
                    "help": "分页浏览全部颜色名称、拼音和 HEX",
                    "usage": "/color list [页码]",
                    "examples": ["/color list", "/color list 2", "/color -l 3"],
                    "invalid_examples": ["/color list 0", "/color list two"]
                },
                {
                    "name": "search",
                    "aliases": ["find", "搜索", "-q", "--search", "-a", "--accord"],
                    "help": "按名称或拼音搜索，并分页显示结果",
                    "usage": "/color search <关键词> [--page 页码]",
                    "examples": ["/color search 红", "/color search hong --page 2", "/color -a 青"],
                    "invalid_examples": ["/color search", "/color search 红 --page 0"]
                },
                {
                    "name": "random",
                    "aliases": ["rand", "随机"],
                    "help": "从当前可用颜色库随机选择一种颜色",
                    "usage": "/color random [-p|--picture]",
                    "examples": ["/color random", "/color random -p"],
                    "invalid_examples": ["/color random extra"]
                },
                {
                    "name": "star",
                    "aliases": ["stellar", "恒星", "-s", "--stellar"],
                    "help": "查询恒星光谱型对应的近似颜色",
                    "usage": "/color star <光谱型>",
                    "examples": ["/color star G2V", "/color -s G2V"],
                    "invalid_examples": ["/color star"]
                },
                {
                    "name": "stars",
                    "aliases": ["types", "光谱型", "-t", "--spectype"],
                    "help": "分页列出光谱型，可按字面内容筛选",
                    "usage": "/color stars [筛选词] [--page 页码]",
                    "examples": ["/color stars", "/color stars G", "/color -t G"],
                    "invalid_examples": ["/color stars G -p"]
                },
                {
                    "name": "add",
                    "aliases": ["write", "添加", "-w", "--write"],
                    "help": "向当前作用域写入自定义颜色",
                    "usage": "/color add <名称> <R> <G> <B> | /color add <名称> <#HEX>",
                    "permission": "bot_admin",
                    "examples": ["/color add 测试蓝 #3366FF", "/color add \"品牌 蓝\" 51 102 255"],
                    "invalid_examples": ["/color add 测试蓝", "/color add 测试蓝 999 0 0"]
                },
                {
                    "name": "delete",
                    "aliases": ["del", "remove", "删除", "-d", "--delete"],
                    "help": "删除当前作用域的自定义颜色",
                    "usage": "/color delete <名称>",
                    "permission": "bot_admin",
                    "examples": ["/color delete 测试蓝", "/color delete \"品牌 蓝\""],
                    "invalid_examples": ["/color delete"]
                },
                {
                    "name": "help",
                    "aliases": ["h", "帮助", "-h", "--help"],
                    "help": "显示直接查询、浏览、搜索、恒星色和管理员操作",
                    "usage": "/color help",
                    "match": "exact",
                    "examples": ["/color help", "/color -h"],
                    "invalid_examples": ["/color help extra", "/color -h -n 天青"]
                }
            ]
        }
    ],
    "schedule": [],
    "dependencies": [
        {
            "name": "matplotlib",
            "required": false,
            "description": "用于生成颜色图片"
        },
        {
            "name": "numpy",
            "required": false,
            "description": "用于生成颜色图片"
        }
    ]
}
