                            "usage": "/astro obj earth",
                            "match": "exact",
                            "examples": ["/astro obj earth"],
                            "invalid_examples": ["/astro obj earth extra"]
                        },
                        {
                            "name": "mercury",
                            "help": "显示水星资料",
                            "usage": "/astro obj mercury",
                            "match": "exact",
                            "examples": ["/astro obj mercury"],
                            "invalid_examples": ["/astro obj mercury extra"]
                        },
                        {
                            "name": "venus",
                            "help": "显示金星资料",
                            "usage": "/astro obj venus",
                            "match": "exact",
                            "examples": ["/astro obj venus"],
                            "invalid_examples": ["/astro obj venus extra"]
                        },
                        {
                            "name": "mars",
                            "help": "显示火星资料",
                            "usage": "/astro obj mars",
                            "match": "exact",
                            "examples": ["/astro obj mars"],
                            "invalid_examples": ["/astro obj mars extra"]
                        },
                        {
                            "name": "jupiter",
                            "help": "显示木星资料",
                            "usage": "/astro obj jupiter",
                            "match": "exact",
                            "examples": ["/astro obj jupiter"],
                            "invalid_examples": ["/astro obj jupiter extra"]
                        },
                        {
                            "name": "saturn",
                            "help": "显示土星资料",
                            "usage": "/astro obj saturn",
                            "match": "exact",
                            "examples": ["/astro obj saturn"],
                            "invalid_examples": ["/astro obj saturn extra"]
                        },
                        {
                            "name": "uranus",
                            "help": "显示天王星资料",
                            "usage": "/astro obj uranus",
                            "match": "exact",
                            "examples": ["/astro obj uranus"],
                            "invalid_examples": ["/astro obj uranus extra"]
                        },
                        {
                            "name": "neptune",
                            "help": "显示海王星资料",
                            "usage": "/astro obj neptune",
                            "match": "exact",
                            "examples": ["/astro obj neptune"],
                            "invalid_examples": ["/astro obj neptune extra"]
                        },
                        {
                            "name": "help",
                            "aliases": ["帮助"],
                            "help": "显示天文工具总帮助",
                            "usage": "/astro obj help",
                            "match": "exact",
                            "examples": ["/astro obj help"],
                            "invalid_examples": ["/astro obj help extra"]
                        }
                    ]
                },
                {
                    "name": "const",
                    "help": "列出或查询内置物理与天文常数",
                    "usage": "/astro const [常数名]",
                    "examples": ["/astro const", "/astro const c"],
                    "invalid_examples": ["/astro const unknown"],
                    "subcommands": [
                        {
                            "name": "c",
                            "aliases": ["speed", "light"],
                            "help": "查询光速",
                            "usage": "/astro const c",
                            "match": "exact",
                            "examples": ["/astro const c"],
                            "invalid_examples": ["/astro const c extra"]
                        },
                        {
                            "name": "g",
                            "aliases": ["gravity"],
                            "help": "查询引力常数",
                            "usage": "/astro const g",
                            "match": "exact",
                            "examples": ["/astro const g"],
                            "invalid_examples": ["/astro const g extra"]
                        },
                        {
                            "name": "h",
                            "aliases": ["planck"],
                            "help": "查询普朗克常数",
                            "usage": "/astro const h",
                            "match": "exact",
