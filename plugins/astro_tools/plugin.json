                            "aliases": ["sun_mass"],
                            "help": "查询太阳质量",
                            "usage": "/astro const m_sun",
                            "match": "exact",
                            "examples": ["/astro const m_sun"],
                            "invalid_examples": ["/astro const m_sun extra"]
                        },
                        {
