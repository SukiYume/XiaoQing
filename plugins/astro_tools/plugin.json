{
    "name": "astro_tools",
    "version": "1.0.0",
    "description": "天文计算工具箱 - 时间转换、坐标转换、天文对象查询、单位转换、公式速查、天文常数",
    "entry": "main.py",
    "commands": [
        {
            "name": "astro",
            "triggers": ["astro"],
            "help": "天文工具箱：时间、坐标、单位、红移、公式、天体和常数",
            "admin_only": false,
            "usage": "/astro <time|coord|convert|redshift|formula|obj|const> [参数]",
            "examples": ["/astro time now", "/astro convert 3 Jy mJy"],
            "invalid_examples": ["/astro unknown", "/astro convert 3 Jy"],
            "subcommands": [
                {
                    "name": "time",
                    "help": "转换 ISO、JD、MJD、Unix 时间，空参数表示当前时间",
                    "usage": "/astro time [now|jd <值>|mjd <值>|unix <值>|时间值]",
                    "examples": ["/astro time", "/astro time 2026-01-30T12:00:00"],
                    "invalid_examples": ["/astro time not-a-time"],
                    "subcommands": [
                        {
                            "name": "now",
                            "help": "显示当前 UTC、JD、MJD、Unix 和恒星时",
                            "usage": "/astro time now",
                            "match": "exact",
                            "examples": ["/astro time now"],
                            "invalid_examples": ["/astro time now extra"]
                        },
                        {
                            "name": "jd",
                            "help": "把儒略日转换为日期时间",
                            "usage": "/astro time jd <儒略日>",
                            "examples": ["/astro time jd 2460419.5"],
                            "invalid_examples": ["/astro time jd nope"]
                        },
                        {
                            "name": "mjd",
                            "help": "把修正儒略日转换为日期时间",
                            "usage": "/astro time mjd <修正儒略日>",
                            "examples": ["/astro time mjd 60419.5"],
                            "invalid_examples": ["/astro time mjd nope"]
                        },
                        {
                            "name": "unix",
                            "help": "把 Unix 时间戳转换为天文时间",
                            "usage": "/astro time unix <时间戳>",
                            "examples": ["/astro time unix 1706616000"],
                            "invalid_examples": ["/astro time unix nope"]
                        },
                        {
                            "name": "help",
                            "aliases": ["帮助"],
                            "help": "显示天文工具总帮助",
                            "usage": "/astro time help",
                            "match": "exact",
                            "examples": ["/astro time help"],
                            "invalid_examples": ["/astro time help extra"]
                        }
                    ]
                },
                {
                    "name": "coord",
                    "help": "转换 ICRS、银道和黄道坐标",
                    "usage": "/astro coord <RA> <Dec> | /astro coord <galactic|ecliptic> <经度> <纬度>",
                    "examples": ["/astro coord 12:34:56 +12:34:56"],
                    "invalid_examples": ["/astro coord 12:34:56"],
                    "subcommands": [
                        {
                            "name": "galactic",
                            "help": "把银道坐标转换为 ICRS",
                            "usage": "/astro coord galactic <银经> <银纬>",
                            "examples": ["/astro coord galactic 120 30"],
                            "invalid_examples": ["/astro coord galactic 120"]
                        },
                        {
                            "name": "ecliptic",
                            "help": "把黄道坐标转换为 ICRS",
                            "usage": "/astro coord ecliptic <黄经> <黄纬>",
                            "examples": ["/astro coord ecliptic 90 23.5"],
                            "invalid_examples": ["/astro coord ecliptic 90"]
                        },
                        {
                            "name": "help",
                            "aliases": ["帮助"],
                            "help": "显示天文工具总帮助",
                            "usage": "/astro coord help",
                            "match": "exact",
                            "examples": ["/astro coord help"],
                            "invalid_examples": ["/astro coord help extra"]
                        }
                    ]
                },
                {
                    "name": "convert",
                    "help": "转换 Astropy 支持的物理单位",
                    "usage": "/astro convert <数值> <源单位> <目标单位>",
                    "examples": ["/astro convert 3 Jy mJy"],
                    "invalid_examples": ["/astro convert 3 Jy"],
                    "subcommands": [
                        {
                            "name": "help",
                            "aliases": ["帮助"],
                            "help": "显示天文工具总帮助",
                            "usage": "/astro convert help",
                            "match": "exact",
                            "examples": ["/astro convert help"],
                            "invalid_examples": ["/astro convert help extra"]
                        }
                    ]
                },
                {
                    "name": "redshift",
                    "help": "按 Planck 2018 宇宙学参数计算红移距离和年龄",
                    "usage": "/astro redshift <0-1100>",
                    "examples": ["/astro redshift 0.5"],
                    "invalid_examples": ["/astro redshift -1"],
                    "subcommands": [
                        {
                            "name": "help",
                            "aliases": ["帮助"],
                            "help": "显示天文工具总帮助",
                            "usage": "/astro redshift help",
                            "match": "exact",
                            "examples": ["/astro redshift help"],
                            "invalid_examples": ["/astro redshift help extra"]
                        }
                    ]
                },
                {
                    "name": "formula",
                    "help": "列出、查询或计算内置天文公式",
                    "usage": "/astro formula [list|公式名|calc <类型> <质量>]",
                    "examples": ["/astro formula", "/astro formula dm"],
                    "invalid_examples": ["/astro formula unknown"],
                    "subcommands": [
                        {
                            "name": "list",
                            "help": "列出全部内置公式",
                            "usage": "/astro formula list",
                            "match": "exact",
                            "examples": ["/astro formula list"],
                            "invalid_examples": ["/astro formula list extra"]
                        },
                        {
                            "name": "calc",
                            "help": "执行质量相关的天文公式计算",
                            "usage": "/astro formula calc <schwarzschild|luminosity|lifetime> <太阳质量>",
                            "examples": ["/astro formula calc schwarzschild 10"],
                            "invalid_examples": ["/astro formula calc unknown 10"],
                            "subcommands": [
                                {
                                    "name": "schwarzschild",
                                    "help": "计算史瓦西半径",
                                    "usage": "/astro formula calc schwarzschild <太阳质量>",
                                    "examples": ["/astro formula calc schwarzschild 10"],
                                    "invalid_examples": ["/astro formula calc schwarzschild -1"]
                                },
                                {
                                    "name": "luminosity",
                                    "help": "估算主序星光度",
                                    "usage": "/astro formula calc luminosity <太阳质量>",
                                    "examples": ["/astro formula calc luminosity 2"],
                                    "invalid_examples": ["/astro formula calc luminosity zero"]
                                },
                                {
                                    "name": "lifetime",
                                    "help": "估算主序星寿命",
                                    "usage": "/astro formula calc lifetime <太阳质量>",
                                    "examples": ["/astro formula calc lifetime 2"],
                                    "invalid_examples": ["/astro formula calc lifetime 0"]
                                }
                            ]
                        },
                        {
                            "name": "dm",
                            "help": "查看色散量公式",
                            "usage": "/astro formula dm",
                            "match": "exact",
                            "examples": ["/astro formula dm"],
                            "invalid_examples": ["/astro formula dm extra"]
                        },
                        {
                            "name": "redshift",
                            "help": "查看红移定义公式",
                            "usage": "/astro formula redshift",
                            "match": "exact",
                            "examples": ["/astro formula redshift"],
                            "invalid_examples": ["/astro formula redshift extra"]
                        },
                        {
                            "name": "luminosity",
                            "help": "查看光度距离公式",
                            "usage": "/astro formula luminosity",
                            "match": "exact",
                            "examples": ["/astro formula luminosity"],
                            "invalid_examples": ["/astro formula luminosity extra"]
                        },
                        {
                            "name": "flux",
                            "help": "查看流量密度公式",
                            "usage": "/astro formula flux",
                            "match": "exact",
                            "examples": ["/astro formula flux"],
                            "invalid_examples": ["/astro formula flux extra"]
                        },
                        {
                            "name": "blackbody",
                            "help": "查看黑体辐射公式",
                            "usage": "/astro formula blackbody",
                            "match": "exact",
                            "examples": ["/astro formula blackbody"],
                            "invalid_examples": ["/astro formula blackbody extra"]
                        },
                        {
                            "name": "parallax",
                            "help": "查看视差距离公式",
                            "usage": "/astro formula parallax",
                            "match": "exact",
                            "examples": ["/astro formula parallax"],
                            "invalid_examples": ["/astro formula parallax extra"]
                        },
                        {
                            "name": "schwarzschild",
                            "help": "查看史瓦西半径公式",
                            "usage": "/astro formula schwarzschild",
                            "match": "exact",
                            "examples": ["/astro formula schwarzschild"],
                            "invalid_examples": ["/astro formula schwarzschild extra"]
                        },
                        {
                            "name": "stellar_luminosity",
                            "help": "查看主序星质光关系",
                            "usage": "/astro formula stellar_luminosity",
                            "match": "exact",
                            "examples": ["/astro formula stellar_luminosity"],
                            "invalid_examples": ["/astro formula stellar_luminosity extra"]
                        },
                        {
                            "name": "stellar_lifetime",
                            "help": "查看主序星寿命公式",
                            "usage": "/astro formula stellar_lifetime",
                            "match": "exact",
                            "examples": ["/astro formula stellar_lifetime"],
                            "invalid_examples": ["/astro formula stellar_lifetime extra"]
                        },
                        {
                            "name": "help",
                            "aliases": ["帮助"],
                            "help": "显示天文工具总帮助",
                            "usage": "/astro formula help",
                            "match": "exact",
                            "examples": ["/astro formula help"],
                            "invalid_examples": ["/astro formula help extra"]
                        }
                    ]
                },
                {
                    "name": "obj",
                    "help": "查询太阳系内置对象或从 SIMBAD 查询其他天体",
                    "usage": "/astro obj <天体名称>",
                    "examples": ["/astro obj sun", "/astro obj Crab Pulsar"],
                    "invalid_examples": ["/astro obj"],
                    "subcommands": [
                        {
