{
    "name": "pendo",
    "version": "1.0.0",
    "description": "个人时间与信息管理中枢 - 日程、待办、想法、日记、笔记一体化管理工具",
    "author": "XiaoQing",
    "commands": [
        {
            "name": "pendo",
            "triggers": [
                "pendo",
                "日程",
                "待办",
                "日记"
            ],
            "help": "个人时间与信息管理中枢\nWeb: /pendo web token | /pendo web widget-token\n\n使用 /pendo help 查看详细帮助",
            "usage": "/pendo <subcommand> [args...]"
        }
    ],
    "dependencies": [],
    "entry": "main.py",
    "schedule": [
        {
            "id": "pendo_reminders",
            "handler": "scheduled",
            "cron": {
                "minute": "*"
            },
            "description": "每分钟检查提醒（事件/待办提醒按分钟级触发）"
        },
        {
            "id": "pendo_daily_briefing",
            "handler": "scheduled_daily_briefing",
            "cron": {
                "minute": "*"
            },
            "description": "每日简报 - 用户可自定义本地时间，因此按分钟检查"
        },
        {
            "id": "pendo_diary_reminder",
            "handler": "scheduled_diary_reminder",
            "cron": {
                "minute": "*"
            },
            "description": "日记提醒 - 用户可自定义本地时间，因此按分钟检查"
        },
        {
            "id": "pendo_migrate_todos",
            "handler": "scheduled_migrate_todos",
            "cron": {
                "hour": 0,
                "minute": 5
            },
            "description": "待办迁移 - 每天00:05执行"
        },
        {
            "id": "pendo_weekly_finance_summary",
            "handler": "scheduled_weekly_finance_summary",
            "cron": {
                "day_of_week": "sun",
                "hour": 21,
                "minute": 0
            },
            "description": "每周财务总结 - 每周日 21:00 执行"
        },
        {
            "id": "pendo_month_end_finance_summary",
            "handler": "scheduled_month_end_finance_summary",
            "cron": {
                "day": "last",
                "hour": 21,
                "minute": 0
            },
            "description": "月底财务总结 - 每月最后一天 21:00 执行"
        },
        {
            "id": "pendo_cleanup_demo_data",
            "handler": "scheduled_cleanup_demo_data",
            "cron": {
                "hour": "*/6",
                "minute": 15
            },
            "description": "定期清理过期的 Pendo Web demo 数据 - 每 6 小时执行一次"
        }
    ]
}
