from __future__ import annotations

import argparse
import io
import json
import re
import sys
from collections import defaultdict
from datetime import datetime
from pathlib import Path
from typing import Any
from zoneinfo import ZoneInfo


SCRIPT_DIR = Path(__file__).resolve().parent
ROOT = Path(__file__).resolve().parents[3]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from plugins.pendo.web.services.transfer_bundle import (  # noqa: E402
    TYPE_FILE_NAMES,
    TRANSFER_VERSION,
    build_manifest,
    compute_sha256,
    write_bundle,
)


ENTRY_RE = re.compile(
    r"(?m)^(\d{4}/\d{1,2}/\d{1,2} \d{2}:\d{2}) - (calendar|note|todo|journal):\s*$"
)
FIELD_RE = re.compile(r"^:([^:]+):\s?(.*)$")
DATE_ONLY_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")

TYPE_MAP = {
    "calendar": "event",
    "note": "note",
    "todo": "task",
    "journal": "diary",
}
TODO_RE = re.compile(r"^\s*-\s*\[([vxX\s])\]\s*(.+?)\s*$")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="把 legacy 文本备份转换成 Pendo Web 可导入的 .pendo.zip bundle。"
    )
    parser.add_argument(
        "input",
        nargs="?",
        default="../data/pendo_other.txt",
        help="原始文本文件路径，默认使用 ../data/pendo_other.txt",
    )
    parser.add_argument(
        "-o",
        "--output",
        help="输出 bundle 路径，默认与输入同名并追加 .pendo.zip",
    )
    parser.add_argument(
        "--timezone",
        default="Asia/Shanghai",
        help="写入 bundle 的时区，默认 Asia/Shanghai",
    )
    return parser.parse_args()


def parse_entries(text: str) -> list[dict[str, Any]]:
    matches = list(ENTRY_RE.finditer(text))
    entries: list[dict[str, Any]] = []
    for idx, match in enumerate(matches):
        start = match.end()
        end = matches[idx + 1].start() if idx + 1 < len(matches) else len(text)
        raw_body = text[start:end].strip("\n")
        entries.append(
            {
                "timestamp": match.group(1),
                "source_type": match.group(2),
                "raw_body": raw_body,
                "fields": parse_fields(raw_body),
            }
        )
    return entries


def parse_fields(body: str) -> dict[str, str]:
    fields: dict[str, str] = {}
    current_key: str | None = None
    buffer: list[str] = []

    def flush() -> None:
        nonlocal current_key, buffer
        if current_key is None:
            return
        value = "\n".join(buffer).strip("\n")
        fields[current_key] = value
        current_key = None
        buffer = []

    for line in body.splitlines():
        matched = FIELD_RE.match(line)
        if matched:
            flush()
            current_key = normalize_field_name(matched.group(1))
            buffer = [matched.group(2)]
            continue
        if current_key is None:
            continue
        buffer.append(line)

    flush()
    return fields


def normalize_field_name(name: str) -> str:
    key = name.strip()
    aliases = {
        "标题": "title",
        "标签": "tags",
        "地址": "address",
        "原文": "original_text",
        "去向": "destination",
        "时区": "timezone",
        "字体大小": "font_size",
        "url": "url",
        "address": "address",
        "id": "source_id",
    }
    return aliases.get(key, key.lower())


def parse_header_datetime(value: str, timezone: str) -> str:
    dt = datetime.strptime(value, "%Y/%m/%d %H:%M")
    return dt.replace(tzinfo=ZoneInfo(normalize_timezone(timezone))).isoformat(timespec="seconds")


def normalize_timezone(value: str | None, default: str = "Asia/Shanghai") -> str:
    text = (value or "").strip()
    if not text:
        return default
    matched = re.search(r"[A-Za-z]+/[A-Za-z0-9_\-+]+", text)
    candidate = matched.group(0) if matched else text
    try:
        ZoneInfo(candidate)
        return candidate
    except Exception:
        return default


def make_import_id(source_type: str, source_id: str | None, timestamp: str, title_hint: str) -> str:
    safe_source_id = (source_id or "").strip()
    if safe_source_id:
        return f"legacy_{source_type}_{safe_source_id}"
    stamp = timestamp.replace("/", "").replace(":", "").replace(" ", "_")
    title_part = re.sub(r"[^a-zA-Z0-9\u4e00-\u9fff]+", "_", title_hint).strip("_")
    title_part = title_part[:24] or "item"
    return f"legacy_{source_type}_{stamp}_{title_part}"


def first_non_empty_line(text: str) -> str:
    for line in text.splitlines():
        value = line.strip()
        if value:
            return value
    return ""


def default_category() -> str:
    return "未分类"


def normalized_content(block: str) -> str:
    return block.strip("\n")


def build_event_record(entry: dict[str, Any], timezone: str) -> dict[str, Any]:
    fields = entry["fields"]
    title_block = normalized_content(fields.get("title", ""))
    title = first_non_empty_line(title_block)
    title = title or "导入日程"
    location = fields.get("address", "").strip()
    notes_parts = []
    title_lines = title_block.splitlines()
    if len(title_lines) > 1:
        notes_parts.append("\n".join(title_lines[1:]).strip("\n"))
    if fields.get("original_text", "").strip():
        notes_parts.append(f"原文：{fields['original_text'].strip()}")
    if fields.get("url", "").strip():
        notes_parts.append(f"链接：{fields['url'].strip()}")
    if fields.get("destination", "").strip():
        notes_parts.append(f"来源去向：{fields['destination'].strip()}")
    record_id = make_import_id("calendar", fields.get("source_id"), entry["timestamp"], title)
    timezone_value = normalize_timezone(fields.get("timezone") or timezone, timezone)
    iso_time = parse_header_datetime(entry["timestamp"], timezone_value)
    return {
        "_type": "event",
        "_schema": TRANSFER_VERSION,
        "id": record_id,
        "title": title,
        "category": default_category(),
        "tags": [],
        "start_time": iso_time,
        "end_time": None,
        "timezone": timezone_value,
        "location": location,
        "notes": "\n\n".join(part for part in notes_parts if part).strip(),
        "reminder_rules": [],
        "remind_times": [],
        "created_at": iso_time,
        "updated_at": iso_time,
        "context": {
            "import": {
                "source": "legacy-text-export",
                "source_type": "calendar",
                "source_id": fields.get("source_id"),
            }
        },
    }


def build_note_record(entry: dict[str, Any], timezone: str) -> dict[str, Any]:
    fields = entry["fields"]
    block = normalized_content(fields.get("title", ""))
    title_hint = first_non_empty_line(block) or "导入笔记"
    title = title_hint[:200] or "导入笔记"
    record_id = make_import_id("note", fields.get("source_id"), entry["timestamp"], title)
    created_at = parse_header_datetime(entry["timestamp"], timezone)
    return {
        "_type": "note",
        "_schema": TRANSFER_VERSION,
        "id": record_id,
        "title": title,
        "content": block,
        "category": default_category(),
        "tags": [],
        "created_at": created_at,
        "updated_at": created_at,
        "context": {
            "import": {
                "source": "legacy-text-export",
                "source_type": "note",
                "source_id": fields.get("source_id"),
            }
        },
    }





def build_diary_record(entry: dict[str, Any], timezone: str) -> dict[str, Any]:
    fields = entry["fields"]
    block = normalized_content(fields.get("title", ""))
    first_line = first_non_empty_line(block)
    diary_date = datetime.strptime(entry["timestamp"], "%Y/%m/%d %H:%M").strftime("%Y-%m-%d")
    content = block
    if first_line and DATE_ONLY_RE.match(first_line):
        content_lines = block.splitlines()
        drop_index = next((index for index, line in enumerate(content_lines) if line.strip()), None)
        if drop_index is not None:
            content = "\n".join(content_lines[drop_index + 1:]).strip("\n")
    record_id = make_import_id("journal", fields.get("source_id"), entry["timestamp"], diary_date)
    created_at = parse_header_datetime(entry["timestamp"], timezone)
    return {
        "_type": "diary",
        "_schema": TRANSFER_VERSION,
        "id": record_id,
        "title": diary_date,
        "content": content,
        "diary_date": diary_date,
        "entry_time": created_at,
        "tags": [],
        "created_at": created_at,
        "updated_at": created_at,
        "context": {
            "import": {
                "source": "legacy-text-export",
                "source_type": "journal",
                "source_id": fields.get("source_id"),
            }
        },
    }


def build_task_records(entry: dict[str, Any], timezone: str) -> list[dict[str, Any]]:
    fields = entry["fields"]
    block = normalized_content(fields.get("title", ""))
    created_at = parse_header_datetime(entry["timestamp"], timezone)
    source_title = first_non_empty_line(block) or "导入待办"
    tasks: list[dict[str, Any]] = []

    for index, line in enumerate(block.splitlines(), 1):
        matched = TODO_RE.match(line)
        if not matched:
            continue
        status_mark = matched.group(1).strip().lower()
        title = matched.group(2).strip()
        if not title:
            continue
        record_id = f"{make_import_id('todo', fields.get('source_id'), entry['timestamp'], source_title)}_{index:03d}"
        done = status_mark in {"v", "x"}
        tasks.append(
            {
                "_type": "task",
                "_schema": TRANSFER_VERSION,
                "id": record_id,
                "title": title[:200],
                "content": "",
                "category": default_category(),
                "tags": [],
                "priority": 3,
                "status": "done" if done else "open",
                "completed_at": created_at if done else None,
                "created_at": created_at,
                "updated_at": created_at,
                "context": {
                    "import": {
                        "source": "legacy-text-export",
                        "source_type": "todo",
                        "source_id": fields.get("source_id"),
                        "source_title": source_title,
                    }
                },
            }
        )

    if tasks:
        return tasks

    record_id = make_import_id("todo", fields.get("source_id"), entry["timestamp"], source_title)
    return [
        {
            "_type": "task",
            "_schema": TRANSFER_VERSION,
            "id": record_id,
            "title": source_title[:200],
            "content": block,
            "category": default_category(),
            "tags": [],
            "priority": 3,
            "status": "open",
            "created_at": created_at,
            "updated_at": created_at,
            "context": {
                "import": {
                    "source": "legacy-text-export",
                    "source_type": "todo",
                    "source_id": fields.get("source_id"),
                }
            },
        }
    ]


def convert_entries(entries: list[dict[str, Any]], timezone: str) -> dict[str, list[dict[str, Any]]]:
    records: dict[str, list[dict[str, Any]]] = defaultdict(list)
    builders = {
        "calendar": build_event_record,
        "note": build_note_record,
        "todo": build_task_records,
        "journal": build_diary_record,
    }
    for entry in entries:
        builder = builders.get(entry["source_type"])
        if not builder:
            continue
        built = builder(entry, timezone)
        record_list = built if isinstance(built, list) else [built]
        records[TYPE_MAP[entry["source_type"]]].extend(record_list)
    return {key: value for key, value in records.items() if value}


def build_bundle(records_by_type: dict[str, list[dict[str, Any]]], timezone: str) -> bytes:
    files = []
    for item_type, records in records_by_type.items():
        payload = ("\n".join(json.dumps(record, ensure_ascii=False) for record in records) + "\n").encode("utf-8")
        files.append(
            {
                "path": TYPE_FILE_NAMES[item_type],
                "type": item_type,
                "count": len(records),
                "sha256": compute_sha256(payload),
            }
        )
    manifest = build_manifest(
        {
            "types": list(records_by_type.keys()),
            "preset": "all",
            "start": None,
            "end": None,
        },
        files,
        timezone,
    )
    manifest["source"]["app"] = "legacy-text-converter"
    buffer = io.BytesIO()
    write_bundle(buffer, manifest, records_by_type)
    return buffer.getvalue()


def main() -> int:
    args = parse_args()
    raw_input_path = Path(args.input).expanduser()
    if raw_input_path.is_absolute():
        input_path = raw_input_path.resolve()
    else:
        input_path = (SCRIPT_DIR / raw_input_path).resolve()
    if not input_path.exists():
        print(f"输入文件不存在：{input_path}", file=sys.stderr)
        return 1

    if args.output:
        raw_output_path = Path(args.output).expanduser()
        output_path = (
            raw_output_path.resolve()
            if raw_output_path.is_absolute()
            else (Path.cwd() / raw_output_path).resolve()
        )
    else:
        output_path = input_path.with_suffix(input_path.suffix + ".pendo.zip")

    text = input_path.read_text(encoding="utf-8")
    entries = parse_entries(text)
    records_by_type = convert_entries(entries, args.timezone)
    if not records_by_type:
        print("没有解析出可导入的记录。", file=sys.stderr)
        return 1

    bundle_bytes = build_bundle(records_by_type, args.timezone)
    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_bytes(bundle_bytes)

    counts = {item_type: len(rows) for item_type, rows in records_by_type.items()}
    total = sum(counts.values())
    print(f"已生成：{output_path}")
    print(f"总条数：{total}")
    for item_type in sorted(counts):
        print(f"  {item_type}: {counts[item_type]}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
