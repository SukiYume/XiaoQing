{
    "name": "smalltalk",
    "version": "2.0.0",
    "description": "基础闲聊、分域问答和可选语音合成",
    "entry": "main.py",
    "uses_services": ["chat.reply", "voice.synthesize_text"],
    "commands": [
        {
            "name": "qa",
            "triggers": [
                "记忆",
                "记住",
                "学习"
            ],
            "help": "学习固定问答，写入当前会话问答库：保存“我说某句话，你就回答某句话”的对应关系，供smalltalk触发回复。问题取第一个非空白字段，回答取剩余文本；同题可有多个回答。日常 xiaoqing_chat 使用自己的记忆。",
            "admin_only": true,
            "usage": "/记忆 <问题> <回答>",
            "examples": ["/记忆 你是谁 我是小青"],
            "invalid_examples": ["/记忆 只有问题"],
            "subcommands": [
                {
                    "name": "help",
                    "aliases": ["帮助", "?"],
                    "help": "显示问答添加说明",
                    "usage": "/记忆 help",
                    "match": "exact",
                    "examples": ["/记忆 help"],
                    "invalid_examples": ["/记忆 help extra"]
                }
            ]
        },
        {
            "name": "qa_list",
            "triggers": [
                "对话"
            ],
            "help": "空参数列出当前会话已学问题；带问题做精确查找，返回所有对应回答。",
            "admin_only": true,
            "usage": "/对话 [问题]",
            "examples": ["/对话", "/对话 你是谁"],
            "invalid_examples": ["/对话 a b"],
            "subcommands": [
                {
                    "name": "help",
                    "aliases": ["帮助", "?"],
                    "help": "显示问答查询说明",
                    "usage": "/对话 help",
                    "match": "exact",
                    "examples": ["/对话 help"],
                    "invalid_examples": ["/对话 help extra"]
                }
            ]
        },
        {
            "name": "qa_remove",
            "triggers": [
                "删除对话"
            ],
            "help": "给出问题删除该题全部回答；同时给回答时只删除该回答。问题取第一个字段，回答取剩余文本。",
            "admin_only": true,
            "usage": "/删除对话 <问题> [回答]",
            "examples": ["/删除对话 你是谁"],
            "invalid_examples": ["/删除对话"],
            "subcommands": [
                {
                    "name": "help",
                    "aliases": ["帮助", "?"],
                    "help": "显示问答删除说明",
                    "usage": "/删除对话 help",
                    "match": "exact",
                    "examples": ["/删除对话 help"],
                    "invalid_examples": ["/删除对话 help extra"]
                }
            ]
        }
    ],
    "concurrency": "parallel"
}
