{
    "name": "minecraft",
    "version": "4.0.1",
    "enabled": true,
    "description": "Minecraft 服务器通信插件 - 支持多服务器连接、RCON命令执行和状态查询",
    "entry": "main.py",
    "commands": [
        {
            "name": "mc",
            "triggers": [
                "mc",
                "minecraft"
            ],
            "help": "连接已配置的 Minecraft 服务器并通过 RCON 查询或操作。status 看连接、list 查玩家，say 发全服消息，tell 私信玩家，run 执行服务器命令；先用 connect 配置名 建立当前会话连接。",
            "usage": "/mc <help|say|tell|list|status|run|connect|disconnect> [参数]",
            "examples": [
                "/mc status",
                "/mc list",
                "/mc say 大家好",
                "/mc tell Steve 你好"
            ],
            "invalid_examples": ["/mc connect", "/mc say"],
            "subcommands": [
                {
                    "name": "connect",
                    "aliases": ["连接"],
                    "help": "为本会话连接清单中的服务器配置",
                    "permission": "bot_admin",
                    "usage": "/mc connect <配置名>",
                    "examples": ["/mc connect default"],
                    "invalid_examples": ["/mc connect"]
                },
                {
                    "name": "disconnect",
                    "aliases": ["断开"],
                    "help": "断开本会话的服务器连接",
                    "permission": "bot_admin",
                    "usage": "/mc disconnect",
                    "match": "exact",
                    "examples": ["/mc disconnect"],
                    "invalid_examples": ["/mc disconnect extra"]
                },
                {
                    "name": "status",
                    "aliases": ["状态"],
                    "help": "查看连接和日志监控状态",
                    "usage": "/mc status",
                    "match": "exact",
                    "examples": ["/mc status"],
                    "invalid_examples": ["/mc status extra"]
                },
                {
                    "name": "list",
                    "help": "查看在线玩家",
                    "usage": "/mc list",
                    "match": "exact",
                    "examples": ["/mc list"],
                    "invalid_examples": ["/mc list extra"]
                },
                {
                    "name": "say",
                    "help": "用自己的 QQ 名字对游戏里所有人说",
                    "usage": "/mc say <消息>",
                    "examples": ["/mc say 大家好"],
                    "invalid_examples": ["/mc say"]
                },
                {
                    "name": "tell",
                    "help": "悄悄对一名在线玩家说",
                    "usage": "/mc tell <玩家名> <消息>",
                    "examples": ["/mc tell Steve 你好"],
                    "invalid_examples": ["/mc tell Steve"]
                },
                {
                    "name": "run",
                    "aliases": ["执行"],
                    "help": "原样执行一条服务器命令",
                    "usage": "/mc run <服务器命令>",
                    "permission": "bot_admin",
                    "examples": ["/mc run time set day"],
                    "invalid_examples": ["/mc run"]
                },
                {
                    "name": "help",
                    "aliases": ["帮助", "?"],
                    "help": "显示 Minecraft RCON 说明",
                    "usage": "/mc help",
                    "match": "exact",
                    "examples": ["/mc help"],
                    "invalid_examples": ["/mc help extra"]
                }
            ]
        },
        {
            "name": "mcconnect",
            "triggers": [
                "mcconnect",
                "mc连接"
            ],
            "help": "连接 MC 服务器 | /mcconnect <配置名>",
            "admin_only": true,
            "priority": 1,
            "usage": "/mcconnect <配置名>",
            "examples": ["/mcconnect default"],
            "invalid_examples": ["/mcconnect"]
        },
        {
            "name": "mcdisconnect",
            "triggers": [
                "mcdisconnect",
                "mc断开"
            ],
            "help": "断开当前 MC 服务器连接 | /mc disconnect",
            "admin_only": true,
            "priority": 1,
            "usage": "/mcdisconnect",
            "examples": ["/mcdisconnect"],
            "invalid_examples": ["/mcdisconnect extra"]
        }
    ],
    "schedule": [
        {
            "id": "check_log",
            "handler": "scheduled",
            "delivery": "targeted",
            "cron": {
                "second": "*/5"
            },
            "enabled": true
        }
    ]
}
