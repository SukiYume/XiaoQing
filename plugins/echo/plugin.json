{
    "name": "echo",
    "version": "0.2.0",
    "description": "有界文本回显与问候示例",
    "entry": "main.py",
    "commands": [
        {
            "name": "echo",
            "triggers": [
                "echo",
                "回显"
            ],
            "help": "回显最多 3000 字的文本 | /echo <文本>",
            "admin_only": false,
            "usage": "/echo <文本>",
            "examples": ["/echo hello world"],
            "invalid_examples": ["/echo"]
        },
        {
            "name": "hello",
            "triggers": [
                "hello",
                "你好"
            ],
            "help": "使用当前 QQ 号打招呼 | /hello",
            "admin_only": false,
            "usage": "/hello",
            "examples": ["/hello"],
            "invalid_examples": ["/hello extra"]
        }
    ],
    "schedule": []
}
