{
    "name": "echo",
    "version": "0.2.0",
    "description": "有界文本回显与问候示例",
    "entry": "main.py",
    "commands": [
        {
            "name": "echo",
            "triggers": [
                "echo",
                "回显"
            ],
            "help": "原样回显去除首尾空白后的文本，最多3000字符；支持换行和制表符。",
            "admin_only": false,
            "usage": "/echo <文本>",
            "examples": ["/echo hello world"],
            "invalid_examples": ["/echo"]
        },
        {
            "name": "hello",
            "triggers": [
                "hello",
                "你好"
            ],
            "help": "无参数，按当前 QQ 号打招呼；带参数时返回 /hello 用法。",
            "admin_only": false,
            "usage": "/hello",
            "examples": ["/hello"],
            "invalid_examples": ["/hello extra"]
        }
    ],
    "schedule": []
}
