{
    "name": "twitter",
    "version": "2.0.3",
    "description": "Twitter 图片抓取与随机发送 - 自动抓取、随机推送、智能去重",
    "entry": "main.py",
    "concurrency": "parallel",
    "commands": [
        {
            "name": "twimg",
            "triggers": [
                "twimg",
                "twitter",
                "推特"
            ],
            "help": "从本地推特图片缓存随机取一张图。直接 /twimg；缓存为空时由管理员 /tw_fetch 后台抓取，完成后再次取图。",
            "admin_only": false,
            "usage": "/twimg",
            "examples": ["/twimg"],
            "invalid_examples": ["/twimg extra"],
            "subcommands": [
                {
                    "name": "help",
                    "aliases": ["帮助", "?"],
                    "help": "显示本地图片缓存说明",
                    "usage": "/twimg help",
                    "match": "exact",
                    "examples": ["/twimg help"],
                    "invalid_examples": ["/twimg help extra"]
                }
            ]
        },
        {
            "name": "tw_fetch",
            "triggers": [
                "tw_fetch",
                "抓取推特"
            ],
            "help": "管理员启动配置账号的新图片后台抓取；立即回复接收状态，完成后另行通知。完成通知确认后可用 /twimg 取图。",
            "admin_only": true,
            "usage": "/tw_fetch",
            "examples": ["/tw_fetch"],
            "invalid_examples": ["/tw_fetch extra"],
            "subcommands": [
                {
                    "name": "help",
                    "aliases": ["帮助", "?"],
                    "help": "显示后台抓取与通知说明",
                    "usage": "/tw_fetch help",
                    "match": "exact",
                    "examples": ["/tw_fetch help"],
                    "invalid_examples": ["/tw_fetch help extra"]
                }
            ]
        }
    ],
    "dependencies": [
        {
            "name": "PIL",
            "required": true,
            "description": "用于验证、转换和缓存 Twitter 图片"
        }
    ],
    "schedule": [
        {
            "id": "twitter_fetch",
            "handler": "scheduled_fetch",
            "delivery": "silent",
            "cron": {
                "hour": 3,
                "minute": 0
            }
        }
    ]
}
