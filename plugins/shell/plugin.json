{
    "name": "shell",
    "version": "2.0.1",
    "description": "管理员本地命令执行插件 - 支持命令启用列表、PATH 可用性、超时和输出限制",
    "entry": "main.py",
    "capabilities": ["admin_sessions", "execution_timeout_exempt"],
    "commands": [
        {
            "name": "shell",
            "triggers": [
                "shell",
                "sh",
                "exec"
            ],
            "help": "💻 执行本地命令 | /shell help 查看权限边界和使用说明",
            "admin_only": true,
            "contexts": ["private"],
            "priority": 20,
            "usage": "/shell <启用的本地命令>",
            "examples": ["/shell python --version"],
            "invalid_examples": ["/shell command-not-enabled"],
            "subcommands": [
                {
                    "name": "list",
                    "aliases": ["列表", "-l", "--list"],
                    "help": "查看管理员启用的本地命令入口及当前 PATH 可用性",
                    "usage": "/shell list",
                    "match": "exact",
                    "examples": ["/shell list"],
                    "invalid_examples": ["/shell list extra"]
                },
                {
                    "name": "help",
                    "aliases": ["帮助", "?", "-h", "--help"],
                    "help": "显示执行边界、超时和路径说明",
                    "usage": "/shell help",
                    "match": "exact",
                    "examples": ["/shell help"],
                    "invalid_examples": ["/shell help extra"]
                }
            ]
        }
    ],
    "schedule": []
}
