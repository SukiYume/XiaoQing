{
    "name": "shell",
    "version": "2.1.0",
    "description": "管理员本地命令执行插件 - 支持 direct/Git Bash 终端、命令启用列表、超时和输出限制",
    "entry": "main.py",
    "capabilities": ["execution_timeout_exempt"],
    "commands": [
        {
            "name": "shell",
            "triggers": [
                "shell",
                "sh",
                "exec"
            ],
            "help": "在 Bot 主机执行已启用命令。list 查看入口，help 查看实际终端、默认超时与路径边界。命令需要自行结束；Agent 本机任务使用 run_shell，工作目录由任务环境提供。",
            "admin_only": true,
            "priority": 20,
            "usage": "/shell <启用的本地命令>",
            "examples": ["/shell python --version"],
            "invalid_examples": ["/shell command-not-enabled"],
            "subcommands": [
                {
                    "name": "list",
                    "aliases": ["列表", "-l", "--list"],
                    "help": "查看管理员启用的本地命令入口及当前 PATH 可用性",
                    "usage": "/shell list",
                    "match": "exact",
                    "examples": ["/shell list"],
                    "invalid_examples": ["/shell list extra"]
                },
                {
                    "name": "help",
                    "aliases": ["帮助", "?", "-h", "--help"],
                    "help": "显示执行边界、超时和路径说明",
                    "usage": "/shell help",
                    "match": "exact",
                    "examples": ["/shell help"],
                    "invalid_examples": ["/shell help extra"]
                }
            ]
        }
    ],
    "schedule": []
}
