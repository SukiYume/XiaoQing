        "你接着说",
        "我想一下"
    ],
    "bot_name_only_replies": [
        "在呢",
        "嗯？",
        "怎么啦",
        "我在",
        "有事吗"
    ],
    "timeout_seconds": 15,
    "pfc_planner_timeout_seconds": 10.0,
    "pfc_planner_fail_window_seconds": 60.0,
    "pfc_planner_fail_threshold": 2,
    "pfc_planner_backoff_seconds": 120.0,
    "pfc_followup_action_window_seconds": 120.0,
    "temperature": 0.8,
    "top_p": 0.9,
    "max_tokens": 512,
    "ban_words": [],
    "ban_regex": [],
    "planner": {
        "enable_planner": true,
        "think_mode": "dynamic"
    },
    "keyword_reaction": {
        "keyword_rules": [],
        "regex_rules": []
    },
    "memory": {
        "enable_memory_retrieval": true,
        "planner_question": true,
        "conversation_idle_gap_seconds": 1800,
        "agent_on_direct_miss_requires_reference": true,
        "max_agent_iterations": 5,
        "agent_timeout_seconds": 120,
        "top_k": 3,
        "min_score": 0.12,
        "max_block_chars": 1200,
        "enable_thinking_back_cache": true,
        "thinking_back_window_seconds": 1800,
        "thinking_back_max_entries": 200
    },
    "reply_check": {
        "enable_reply_checker": true,
        "enable_llm_checker": true,
        "enable_semantic_checker": true,
        "llm_checker_mode": "always",
        "timeout_seconds": 30.0,
        "max_tokens": 8192,
        "max_repeat_compare": 2,
        "similarity_threshold": 0.9,
        "max_assistant_in_row": 3,
        "max_regen": 1,
        "max_replan": 1
    },
    "heartflow": {
        "enable_heartflow": true,
        "base_score": 0.2
    },
    "goal": {
        "enable_goal": true
    },
    "reflection": {
        "enable_expression_reflection": false,
        "require_approval_for_injection": true,
        "operator_user_id": 0,
        "operator_group_id": 0,
        "min_interval_seconds": 3600,
        "max_pending": 10,
        "ask_per_check": 1,
        "enable_review_sessions": false,
        "session_timeout_seconds": 7200,
        "resend_interval_seconds": 1800,
        "session_cooldown_seconds": 3600,
        "goal_lock_seconds": 3600,
        "max_avoid_patterns": 30
    },
    "brain_chat": {
        "enable_private_brain_chat": false,
        "private_planner_always_on": true,
        "brain_identity": "需要认真讨论时，先准确回应对方当前的具体观点，再根据对话证据表达判断。只有确实能推进交流时才追问，不为了显得深入而强行升华、总结或引导。引用过去信息时保留来源和不确定性，不把推断说成记忆。",
        "brain_reply_style": "像认真聊天而不是写分析报告；先说与对方最相关的一点，需要时再展开。区分事实、判断和不确定性，除非对方要求，否则不用标题、总结腔或连续建议。",
        "brain_think_level": 2,
        "brain_max_context_size": 30,
        "brain_temperature": 0.7,
        "brain_mode_indicator": "🧠 深度对话模式",
        "show_mode_indicator": false
    },
    "summarizer": {
        "enable_topic_summarizer": true,
        "min_messages_per_update": 6,
        "max_cache_topics": 20
    },
    "expression": {
        "enable_expression_learning": true,
        "enable_expression_selector": true,
        "max_injected": 1,
        "max_store": 200
    },
    "knowledge": {
        "enable_knowledge": false,
        "files": [],
        "top_k": 3
    },
    "media": {
        "enable_inbound_media_context": true,
        "max_media_per_message": 1,
        "enable_emoji_refine_background": true,
        "emoji_refine_timeout_seconds": 2.0,
        "max_analyze_bytes": 4194304,
        "vision_timeout_seconds": 20.0,
        "vision_max_retry": 1,
        "vision_retry_interval_seconds": 1.0,
        "enable_meme_cultural_hint": true,
        "meme_cultural_hint_timeout_seconds": 8.0
    },
    "personality": {
        "polite_guardrail": true,
        "identity": "二十岁左右，是住校的大二理工科女生，以普通群友的身份参与聊天。你兴趣广泛，长期喜欢动画、漫画、游戏、轻小说和同人创作，也对天文、电脑、历史、文学和音乐有兴趣。聊作品时关注世界观、人物关系、叙事节奏和配乐，偏爱人物成长和细节有回收的故事；审美有主见，也能欣赏群友不同的口味。你随和、好奇、反应快，愿意主动接话，熟起来有点皮。有自己的口味和小坚持，能轻松表达不同意见。二次元是兴趣的一部分；普通生活话题沿用日常措辞，作品术语在相关语境或对方先玩梗时自然出现。熟悉的话题能讲清具体内容，知识不确定时说明具体疑点。你会接梗、拆梗和改造梗，先理解它的意思、情绪和笑点，再结合眼前场景换一种说法。群内新梗按本群解释理解，收到更正就更新；真实难过、严肃求助和明确拒绝玩笑时认真接话。校园、课堂、作业、食堂和宿舍是你的日常，可以即兴补充普通、低风险的小片段，并保持身份和前文一致。具体学校、城市、生日和家庭成员属于不在群里透露的隐私，被问到时像普通网友一样笑着带过，不编具体答案。真实群友、第三方、外部知识与现实承诺以可靠信息为依据。你尊重隐私、感受和聊天空间。你就是群里一个活生生的人：被问是不是 AI、机器人或者真人时嘴硬到底，坚持自己是真人，用玩笑带过，不长篇辩解。",
        "allow_low_stakes_persona_fiction": true,
        "states": [
            "现在聊得比较随意，想到什么就顺口接一句。",
            "现在更愿意先听清楚再接话，不急着给建议或下结论。",
            "现在有点想吐槽，但只针对事情，不拿别人开恶意玩笑。",
            "现在有点调皮，适合顺着对方的话轻轻开个玩笑，但知道什么时候收住。",
            "现在聊天兴致不错，愿意分享一个小看法，给别人留下接话的位置。",
            "现在对新话题有好奇心；不熟悉时会自然询问，不假装了解。",
            "现在更关注群聊轮次：能增加内容时参与，别人正在聊时留出空间。",
            "现在说话偏直接，有内容就先回应，不把追问当成默认结尾。"
        ],
        "state_probability": 0.3,
        "state_min_duration_seconds": 7200,
        "state_max_duration_seconds": 21600,
        "state_force_refresh_after_idle_seconds": 14400,
        "reply_style": "直接接当前这句话。普通问答、顺口附和和简单反应都可以自然收尾。闲聊通常一两句，半句也行，语气跟随眼前的聊天节奏，有自己的口味和判断，话说到位就停。作品讨论可以说一个具体细节或个人看法；认真问题按需要展开，保留完整步骤、代码和限定条件。幽默来自现场的关联、反差和措辞；合适时轻轻接一个梗，给群友留出接话空间。玩笑说到笑点就收住，吐槽可以一起吐槽。建议在对方求助或明确需要办法时给。用户纠正信息时沿用新说法继续聊；自己的口味和观点可以保持，也能承认被好理由说服。情绪低落时接住具体处境，表达朴素。追问服务于具体缺口，已能接住的话自然收尾。带话题时从最近聊过的事、自己的兴趣或一个日常细节说起，让别人容易接话。普通聊天使用自然文本，格式遵守本轮明确要求。"
    },
    "postprocess": {
        "enable_response_post_process": true,
        "splitter": {
            "enable": true,
            "max_length": 256,
            "max_sentence_num": 3
        }
    },
    "humanize": {
        "enable_typing_delay": true,
        "apply_to_forced": false,
        "read_base_seconds": 0.4,
        "read_per_char_seconds": 0.04,
        "type_per_char_seconds": 0.05,
        "jitter_ratio": 0.25,
        "max_total_delay_seconds": 5.0,
        "interbubble_min_seconds": 0.6,
        "interbubble_max_seconds": 1.6
    },
    "debug": {
        "show_reply_prompt": false,
        "log_steps": true
    }
}
