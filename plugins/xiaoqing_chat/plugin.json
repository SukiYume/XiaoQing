{
  "name": "xiaoqing_chat",
  "version": "0.2.0",
  "description": "拟人聊天（纯对话 + 可选图片上下文/表情包回复）",
  "entry": "main.py",
  "concurrency": "parallel",
  "capabilities": ["onebot_media", "onebot_actions", "inbound_backlog"],
  "uses_services": ["agent.handle_turn", "agent.report_delivery", "life.turn_context", "life.export_memes", "memory.record", "memory.recall", "memory.search", "memory.forget"],
  "services": [
    {
      "name": "core.observe_outgoing_action",
      "callback": "observe_outgoing_action",
      "callers": ["core"]
    }
  ],
  "watch_files": [
    "config/xiaoqing_config.json",
    "media/qq_face_builtin_catalog.json"
  ],
  "commands": [
    {
      "name": "xc",
      "triggers": ["xc"],
      "help": "拟人聊天与会话管理。/xc 后直接写聊天内容，stats 查状态，memory 关键词 检索本会话记忆，model 查询模型。此入口处理真人消息，Agent 通过共享人设直接表达结果。",
      "admin_only": false,
      "priority": 5,
      "usage": "/xc <聊天内容> | /xc <子命令> [参数]",
      "examples": ["/xc 最近有什么值得聊的？", "/xc stats"],
      "invalid_examples": ["/xc stats extra"],
      "subcommands": [
        {
          "name": "help",
          "aliases": ["帮助", "?"],
          "help": "显示拟人聊天的完整结构化命令目录",
          "usage": "/xc help",
          "match": "exact",
          "examples": ["/xc help"],
          "invalid_examples": ["/xc help extra"]
        },
        {
          "name": "reset",
          "aliases": ["重置", "清空"],
          "help": "私聊重置自己的会话；群里由群管理员用 /xc reset confirm 确认后清空",
          "usage": "/xc reset [确认|confirm]",
          "examples": ["/xc reset", "/xc reset confirm"],
          "invalid_examples": ["/xc reset maybe"],
          "subcommands": [
            {
              "name": "confirm",
              "aliases": ["确认"],
              "help": "确认清空本群与小青相关的共享状态",
              "usage": "/xc reset confirm",
              "permission": "group_admin",
              "contexts": ["group"],
              "match": "exact",
              "examples": ["/xc reset confirm"],
              "invalid_examples": ["/xc reset confirm extra"]
            }
          ]
        },
        {
          "name": "stats",
          "aliases": ["统计", "状态"],
          "help": "查看当前会话的上下文、学习和运行统计",
          "usage": "/xc stats",
          "match": "exact",
          "examples": ["/xc stats"],
          "invalid_examples": ["/xc stats extra"]
        },
        {
          "name": "brain",
          "aliases": ["深度"],
          "help": "查看深度对话模式状态和参数",
          "usage": "/xc brain",
          "match": "exact",
          "examples": ["/xc brain"],
          "invalid_examples": ["/xc brain on"]
        },
        {
          "name": "config",
          "aliases": ["配置"],
          "help": "查看聊天、记忆、表达学习和模型配置概要",
          "usage": "/xc config",
          "match": "exact",
          "examples": ["/xc config"],
          "invalid_examples": ["/xc config set"]
        },
        {
          "name": "memory",
          "aliases": ["记忆"],
          "help": "按关键词检索当前会话可见的长期记忆",
          "usage": "/xc memory <关键词>",
          "examples": ["/xc memory 喜欢的食物"],
          "invalid_examples": ["/xc memory"]
        },
        {
          "name": "expression",
          "aliases": ["表达"],
          "help": "查看当前会话学到的表达方式",
          "usage": "/xc expression",
          "match": "exact",
          "examples": ["/xc expression"],
          "invalid_examples": ["/xc expression extra"]
        },
        {
          "name": "jargon",
          "aliases": ["黑话"],
          "help": "查看当前会话学到的黑话",
          "usage": "/xc jargon",
          "match": "exact",
          "examples": ["/xc jargon"],
          "invalid_examples": ["/xc jargon extra"]
        },
        {
          "name": "review",
          "aliases": ["审查"],
          "help": "管理员处理当前会话的反思审查流程",
          "usage": "/xc review <ok|no|answer|close> <会话ID> [内容]",
          "permission": "group_admin",
          "examples": ["/xc review ok review-123"],
          "invalid_examples": ["/xc review maybe review-123"],
          "subcommands": [
            {
              "name": "ok",
              "help": "确认当前目标和策略并关闭审查会话",
              "usage": "/xc review ok <会话ID>",
              "examples": ["/xc review ok review-123"],
              "invalid_examples": ["/xc review ok"]
            },
            {
              "name": "no",
              "help": "关闭当前审查会话",
              "usage": "/xc review no <会话ID>",
              "examples": ["/xc review no review-123"],
              "invalid_examples": ["/xc review no"]
            },
            {
              "name": "answer",
              "help": "提交新的目标（goal: 开头）或策略备注",
              "usage": "/xc review answer <会话ID> <内容>",
              "examples": ["/xc review answer review-123 strategy: 先接住原话再追问"],
              "invalid_examples": ["/xc review answer review-123"]
            },
            {
              "name": "close",
              "help": "关闭当前审查会话",
              "usage": "/xc review close <会话ID>",
              "examples": ["/xc review close review-123"],
              "invalid_examples": ["/xc review close"]
            }
          ]
        },
        {
          "name": "model",
          "aliases": ["模型", "provider", "供应商"],
          "help": "查看回退链，或固定当前会话/全局模型",
          "usage": "/xc model [名称|default|global <名称|default>]",
          "permission": "group_admin",
          "examples": ["/xc model", "/xc model default"],
          "invalid_examples": ["/xc model global"],
          "subcommands": [
            {
              "name": "default",
              "aliases": ["默认", "reset"],
              "help": "清除当前会话的模型固定设置",
              "usage": "/xc model default",
              "match": "exact",
              "examples": ["/xc model default"],
              "invalid_examples": ["/xc model default extra"]
            },
            {
              "name": "global",
              "aliases": ["全局"],
              "help": "由 Bot 全局管理员设置或清除全局模型固定项",
              "usage": "/xc model global <名称|default>",
              "permission": "bot_admin",
              "examples": ["/xc model global default"],
              "invalid_examples": ["/xc model global"]
            }
          ]
        }
      ]
    },
    {
      "name": "qq",
      "triggers": ["qq"],
      "help": "查看和操作小青的 QQ：列出所在的群和群成员，看任意群或私聊最近的聊天记录，以小青的身份去指定的群或私聊说话，撤回消息，调用其他 OneBot 动作。仅 Bot 管理员，私聊。",
      "permission": "bot_admin",
      "contexts": ["private"],
      "usage": "/qq <groups|members|look|say|recall|call> [参数]",
      "examples": ["/qq groups", "/qq look g123456789"],
      "invalid_examples": ["/qq look"],
      "subcommands": [
        {
          "name": "help",
          "aliases": ["帮助", "?"],
          "help": "显示 /qq 的完整命令目录",
          "usage": "/qq help",
          "match": "exact",
          "examples": ["/qq help"],
          "invalid_examples": ["/qq help extra"]
        },
        {
          "name": "groups",
          "aliases": ["群", "群列表"],
          "help": "列出小青所在的群：群号、群名和人数。只知道群名时先用它查群号",
          "usage": "/qq groups",
          "match": "exact",
          "effect": "read",
          "examples": ["/qq groups"],
          "invalid_examples": ["/qq groups extra"]
        },
        {
          "name": "members",
          "aliases": ["成员"],
          "help": "列出一个群的成员：QQ 号、群名片、昵称和身份；带关键词时只留名片、昵称或 QQ 号里含它的人",
          "usage": "/qq members <群号> [关键词]",
          "effect": "read",
          "examples": ["/qq members 123456789", "/qq members g123456789 阿梨"],
          "invalid_examples": ["/qq members"]
        },
        {
          "name": "look",
          "aliases": ["看", "记录"],
          "help": "看一个会话最近的聊天记录（旧→新），默认 20 条、最多 100 条。每条带时间、说话人和 QQ 号、消息 ID；图片和表情显示小青当时看到的识图描述，原图还在本机时附上文件路径。会话写 g<群号> 或 u<QQ号>",
          "usage": "/qq look <g群号|uQQ号> [条数]",
          "effect": "read",
          "examples": ["/qq look g123456789", "/qq look u10001 50"],
          "invalid_examples": ["/qq look 123456789", "/qq look g123456789 0"]
        },
        {
          "name": "say",
          "aliases": ["说", "发"],
          "help": "以小青的身份把内容原样发到一个群或私聊，发出后记成她在那个会话里的发言。内容就是要发出去的那句话；群里要 @ 人时写 [CQ:at,qq=QQ号]",
          "usage": "/qq say <g群号|uQQ号> <内容>",
          "effect": "write",
          "examples": ["/qq say g123456789 这张图好可爱", "/qq say u10001 我到了"],
          "invalid_examples": ["/qq say g123456789"]
        },
        {
          "name": "recall",
          "aliases": ["撤回"],
          "help": "撤回一条消息，消息 ID 见 look 的输出或 say 的回报。撤回别人的消息需要小青是那个群的管理员",
          "usage": "/qq recall <消息ID>",
          "effect": "write",
          "examples": ["/qq recall 5531"],
          "invalid_examples": ["/qq recall abc"]
        },
        {
          "name": "call",
          "aliases": ["调用"],
          "help": "直接调用一个 OneBot 动作并取回返回数据，用于上面没有覆盖的 QQ 操作（如 set_group_ban 禁言、set_group_card 改群名片、get_stranger_info 查资料）。参数是一个 JSON 对象；发消息用 say",
          "usage": "/qq call <动作名> [JSON 参数]",
          "examples": ["/qq call get_login_info", "/qq call set_group_ban {\"group_id\": 123456789, \"user_id\": 10001, \"duration\": 600}"],
          "invalid_examples": ["/qq call", "/qq call set_group_ban 123"]
        }
      ]
    }
  ],
  "schedule": [
    {
      "id": "xiaoqing_chat.daily_life",
      "handler": "scheduled_daily_life",
      "delivery": "silent",
      "cron": {"hour": 5, "minute": 30},
      "description": "每天早上按人设与作息安排角色今天的生活小事；life.enable_daily_life 关闭时不做事"
    },
    {
      "id": "xiaoqing_chat.life_memes",
      "handler": "scheduled_life_memes",
      "delivery": "silent",
      "cron": {"minute": "7,37"},
      "description": "把 xiaoqing_life 收集的梗图同步进表情库；life.enable_life_memes 关闭或插件不在时不做事"
    },
    {
      "id": "xiaoqing_chat.memory_sync",
      "handler": "scheduled_memory_sync",
      "delivery": "silent",
      "cron": {"minute": "13,43"},
      "description": "把各会话还没推给统一记忆的消息推过去（首次启动导入旧数据、推送失败后补推）；统一记忆不在时不做事"
    },
    {
      "id": "xiaoqing_chat.proactive",
      "handler": "scheduled_proactive",
      "delivery": "targeted",
      "cron": {"minute": "*/20"},
      "description": "冷群时以群友身份主动开口；plugins.xiaoqing_chat.proactive.enabled 打开后生效"
    }
  ],
  "dependencies": [
    {
      "name": "aiohttp",
      "required": true,
      "description": "聊天模型与媒体客户端在入口导入链中直接使用 aiohttp"
    },
    {
      "name": "numpy",
      "required": true,
      "description": "管理员知识库的向量索引在入口导入链中直接使用 NumPy"
    },
    {
      "name": "pydantic",
      "required": true,
      "description": "聊天配置模型在入口导入链中直接使用 Pydantic"
    },
    {
      "name": "PIL",
      "required": false,
      "description": "可选图片和动图分析；缺失时纯文本聊天仍可运行"
    }
  ]
}
