.installed.cfg
*.egg
MANIFEST

# Virtual environments and local env files
.venv/
venv/
ENV/
env/
.env
.env.*
!.env.example
!.env.*.example

# Test, coverage, type-checker and linter caches
.pytest_cache/
.pytest_*/
.coverage
.coverage.*
coverage.xml
coverage*.json
coverage-reports/
htmlcov/
.tox/
.nox/
.hypothesis/
