# Large local model / training artifacts
plugins/arxiv_filter/best_model*/
plugins/arxiv_filter/train_model/**/cache/
plugins/arxiv_filter/train_model/arxiv_papers_with_abstract.csv

# Deprecated plugin workspaces are never part of the production tree.
plugins/*deprecated/
.local_archive/

