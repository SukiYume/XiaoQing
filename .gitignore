.ruff_cache/
.pyre/
.pytype/
.pyright/

# Jupyter notebooks and checkpoints
.ipynb_checkpoints/
*.ipynb

# Node / frontend dependencies and build artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.parcel-cache/
.vite/
coverage/

# IDE and editor state
.idea/
.vscode/
*.swp
*.swo
*~

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Logs and runtime traces
logs/
*.log
*.trace
*.trace.*
*.heapsnapshot
*.network-request
*.network-response

# Local configuration and secrets
config/config.json
config/secrets.json
plugins/minecraft/config.json

# Plugin runtime data, caches and generated reports
/data/
plugins/*/data/
