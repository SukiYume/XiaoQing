{
	"inbound_token": "your-secret-token-here",
	"admin_user_ids": [123456789],
	"ai": {
		"providers": {
			"deepseek": {
				"api_key": "your-deepseek-api-key"
			},
			"zhipu": {
				"api_key": "your-zhipu-api-key"
			}
		}
	},
	"plugins": {
		"arxiv_filter": {
			"feishu_webhook": "https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-id"
		},
		"wolframalpha": {
			"appid": "your-wolframalpha-appid"
		},
		"voice": {
			"subscription_key": "your-azure-speech-key",
			"region": "southeastasia",
			"voice_name": "zh-CN-XiaomoNeural",
			"style": "cheerful",
			"role": "Girl",
			"proxy": ""
		},
		"chat": {
			"token": "pat_your-coze-api-token",
			"bot_id": "your-coze-bot-id",
			"proxy": ""
		},
		"twitter": {
			"user_id": "your-twitter-numeric-user-id",
			"headers": {
				"authorization": "Bearer your-twitter-api-token"
			},
			"cookies": {},
			"proxy": "",
			"max_pages": 50
		},
		"signin": {
			"yingshijufeng": {
				"app_id": "your-wechat-app-id",
				"kdt_id": "your-youzan-shop-id",
				"access_token": "your-youzan-access-token",
				"sid": "your-session-id"
			}
		},
		"ads_paper": {
			"ads_token": "your-ads-api-token"
		}
	}
}
